---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section>
				<p>
					I'm Brandon. I manage platform teams, mass-migrate pipelines, and occasionally build CLI tools during bouts of insomnia.
					I write about engineering leadership, developer experience, and the stuff I wish someone had told me earlier.
				</p>
			</section>
			<section>
				<h2>Recent Posts</h2>
				<ul style="list-style: none; padding: 0;">
					{
						posts.map((post) => (
							<li style="margin-bottom: 2em;">
								<a href={`/blog/${post.slug}/`}>
									<h3 style="margin-bottom: 0.25em;">{post.data.title}</h3>
								</a>
								<FormattedDate date={post.data.pubDate} />
								<p style="margin-top: 0.5em;">{post.data.description}</p>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
