---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TAGLINE, SITE_TITLE } from '../consts';
import { CONTACT_EMAIL, ORG_URL, PROJECTS } from '../data/projects';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_TAGLINE} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero" aria-labelledby="hero-title">
				<p class="prompt" aria-hidden="true"><span class="sigil">$</span> whoami</p>
				<h1 id="hero-title">chaosbit<span class="dot">.dev</span></h1>
				<p class="tagline">{SITE_TAGLINE}</p>
				<p class="intro">
					I'm Brandon. I lead platform teams, migrate pipelines by the thousand, and build tools
					during bouts of insomnia. The ones useful beyond my own homelab end up here as open
					source, and the lessons end up in the writing.
				</p>
				<nav class="cta" aria-label="Sections">
					<a class="button primary" href="#projects">Projects</a>
					<a class="button" href="/blog/">Writing</a>
				</nav>
			</section>

			<section id="projects" aria-labelledby="projects-title">
				<h2 id="projects-title"><span class="sigil" aria-hidden="true">#</span> Projects</h2>
				<ul class="projects">
					{
						PROJECTS.map((project) => (
							<li class="card">
								<h3>
									<a href={project.repo}>{project.name}</a>
								</h3>
								<p>{project.summary}</p>
								<ul class="tags" aria-label="Topics">
									{project.tags.map((tag) => (
										<li>{tag}</li>
									))}
								</ul>
							</li>
						))
					}
				</ul>
				<p class="more"><a href={ORG_URL}>Everything on GitHub →</a></p>
			</section>

			<section id="writing" aria-labelledby="writing-title">
				<h2 id="writing-title"><span class="sigil" aria-hidden="true">#</span> Writing</h2>
				<ul class="posts">
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<h3>{post.data.title}</h3>
								</a>
								<p class="date">
									<FormattedDate date={post.data.pubDate} />
								</p>
								<p>{post.data.description}</p>
							</li>
						))
					}
				</ul>
				<p class="more"><a href="/blog/">All posts →</a></p>
			</section>

			<section id="contact" aria-labelledby="contact-title">
				<h2 id="contact-title"><span class="sigil" aria-hidden="true">#</span> Contact</h2>
				<p>
					Email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>, or find the code at
					<a href={ORG_URL}>github.com/chaosbit-dev</a>.
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 820px;
	}
	section {
		margin-bottom: 4rem;
		scroll-margin-top: 1rem;
	}
	.prompt,
	.sigil,
	.tags li,
	.date {
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
	}
	.sigil {
		color: var(--accent);
	}

	/* Hero */
	.hero {
		padding-top: 1rem;
	}
	.prompt {
		margin: 0 0 0.5rem;
		font-size: 0.85em;
		color: rgb(var(--gray));
	}
	.hero h1 {
		margin-bottom: 0.25rem;
		letter-spacing: -0.02em;
	}
	.dot {
		color: var(--accent);
	}
	.tagline {
		margin: 0 0 1.5rem;
		font-size: 1.25em;
		color: rgb(var(--black));
	}
	.intro {
		max-width: 38em;
	}
	.cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.5rem;
	}
	.button {
		display: inline-block;
		padding: 0.5em 1.25em;
		border: 2px solid var(--accent);
		border-radius: 6px;
		color: var(--accent);
		font-weight: 700;
		text-decoration: none;
		transition:
			background 0.15s ease,
			color 0.15s ease;
	}
	.button.primary {
		background: var(--accent);
		color: #0d1117;
	}
	.button:hover,
	.button:focus-visible {
		background: var(--accent-dark);
		border-color: var(--accent-dark);
		color: #0d1117;
	}

	/* Projects */
	.projects,
	.posts,
	.tags {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.projects {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 1.25rem;
	}
	.card {
		padding: 1.25rem 1.5rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		background: #161b22;
		transition: border-color 0.15s ease;
	}
	.card:hover,
	.card:focus-within {
		border-color: var(--accent);
	}
	.card h3 {
		font-size: 1.25em;
		margin-bottom: 0.5rem;
	}
	.card h3 a {
		text-decoration: none;
	}
	.card p {
		margin: 0 0 1rem;
		font-size: 0.9em;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.tags li {
		padding: 0.1em 0.6em;
		border-radius: 4px;
		background: rgb(var(--gray-light));
		font-size: 0.7em;
		color: rgb(var(--gray-dark));
	}

	/* Writing */
	.posts li {
		padding: 1.25rem 0;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.posts li:first-child {
		padding-top: 0;
	}
	.posts h3 {
		font-size: 1.4em;
		margin-bottom: 0.25rem;
	}
	.posts a {
		text-decoration: none;
	}
	.posts a:hover h3,
	.posts a:focus-visible h3 {
		color: var(--accent);
	}
	.posts p {
		margin: 0;
	}
	.posts .date {
		margin-bottom: 0.5rem;
		font-size: 0.75em;
		color: rgb(var(--gray));
	}
	.more {
		margin-top: 1.25rem;
	}

	@media (max-width: 720px) {
		main {
			font-size: 0.9em;
		}
		.hero h1 {
			font-size: 2.4em;
		}
		.projects {
			grid-template-columns: 1fr;
		}
	}
</style>
